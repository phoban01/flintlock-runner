{{template "prelude" .}}

# The Pool Manager daemon on the Control Node (FL-051), with a host list
# generated from the Inventory (FL-052), regenerated and applied without
# losing a Lease when the Inventory changes (FL-055).
read_secrets
version={{q .Versions.PoolManager}}
[ -n "$version" ] || die "fleet.versions pins no pool_manager version"
opt=/opt/flintlock-runner
bin="$opt/poolmgrd-$version"
etc="$FLR_ETC/poolmgrd"
db_dir=/var/lib/poolmgrd
restart=0
ensure_user poolmgrd "$db_dir"

{{- if and .PMCert .PMKey}}
# The Pool Manager daemon serves TLS from the same certificate and key
# every Host uses (FL-051), written 0600 root:root because until now only
# flintlockd, running as root, needed to read them. poolmgrd runs as its
# own unprivileged system user, so grant that user's group read access
# rather than widen the file to everyone.
if [ -e {{q .PMKey}} ] && [ "$(stat -c '%G:%a' {{q .PMKey}})" != "poolmgrd:640" ]; then
  chgrp poolmgrd {{q .PMKey}}
  chmod 0640 {{q .PMKey}}
  changed "poolmgrd read access to {{q .PMKey}}"
fi
{{- end}}

if [ ! -x "$bin" ]; then
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  asset="poolmgrd_${version#v}_linux_$FLR_ARCH.tar.gz"
  release="https://github.com/liquidmetal-dev/battery/releases/download/$version"
  download "$release/$asset" "$work/$asset"
  download "$release/checksums.txt" "$work/checksums.txt"
  (cd "$work" && grep " $asset\$" checksums.txt | sha256sum -c --quiet -) || die "checksum of $asset does not match"
  tar -xzf "$work/$asset" -C "$work" poolmgrd
  mkdir -p "$opt"
  install -m 0755 "$work/poolmgrd" "$bin"
  changed "poolmgrd $version"
  restart=1
fi

# FL-051: every Inventory Host with its flintlockd endpoint and TLS
# settings. FL-052: under exactly its Inventory name, because the Runner
# joins Placement to the Inventory by name. No token: battery's own
# HostConfig has no field for one, so it has never had a way to send one -
# authentication is TLS-only (FL-024).
{{- if .Insecure}}
host_tls='{"insecure": true}'
{{- else if and .HostCAFile .MutualTLS}}
# flintlockd authenticates the Pool Manager by certificate, not a token
# (FL-024) - it has no other way to send one - so it presents the same
# certificate the Runner does (PMCert/PMKey, already the Control Node's
# own identity for the Pool Manager's own API server).
host_tls="{\"ca_file\": $(json_str {{q .HostCAFile}}), \"cert_file\": $(json_str {{q .PMCert}}), \"key_file\": $(json_str {{q .PMKey}})}"
{{- else if .HostCAFile}}
host_tls="{\"ca_file\": $(json_str {{q .HostCAFile}})}"
{{- else}}
host_tls='{}'
{{- end}}
new_config=$(mktemp)
{
  echo '{'
  echo '  "hosts": ['
  sep=' '
{{- range .PoolManagerHosts}}
  printf '   %s{"name": %s, "address": %s, "tls": %s}\n' "$sep" \
    "$(json_str {{q .Name}})" "$(json_str {{q .Endpoint}})" "$host_tls"
  sep=','
{{- end}}
  echo '  ],'
  printf '  "api_server": {"addr": %s, "tls": %s}\n' "$(json_str {{q .PMListen}})" \
{{- if and .PMCert .PMKey}}
    "{\"cert_file\": $(json_str {{q .PMCert}}), \"key_file\": $(json_str {{q .PMKey}})}"
{{- else}}
    '{"insecure": true}'
{{- end}}
  echo '}'
} >"$new_config"
if write_file "$etc/config.json" 0600 poolmgrd:poolmgrd <"$new_config"; then
  restart=1
fi
rm -f "$new_config"

# The Lease state lives in the SQLite database under $db_dir, which is
# never removed here: a restart for a changed host list keeps every Lease,
# and the Runner's heartbeats resume against the same records (FL-055).
if write_file /etc/systemd/system/poolmgrd.service 0644 <<FLR_EOF
[Unit]
Description=battery Pool Manager daemon
Wants=network-online.target
After=network-online.target

[Service]
User=poolmgrd
Group=poolmgrd
ExecStart=$bin -config $etc/config.json -db $db_dir/poolmgr.db
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
FLR_EOF
then
  FLR_DAEMON_RELOAD=1
  restart=1
fi
ensure_service poolmgrd "$restart"
