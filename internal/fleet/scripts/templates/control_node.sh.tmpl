{{template "prelude" .}}

# The Pool Manager daemon on the Control Node, with a configuration that
# names no Host (FL-125). battery v0.5.0 and later keep their Hosts in their
# own database and refuse to start with a hosts key in the file; the
# Fleet Controller registers the Inventory's Hosts through battery's
# HostAdmin API once the daemon answers (FL-127). Nothing here depends on
# the Inventory, so a change to it never restarts the daemon (FL-133).
read_secrets
version={{q .Versions.PoolManager}}
[ -n "$version" ] || die "fleet.versions pins no pool_manager version"
opt=/opt/flintlock-runner
bin="$opt/poolmgrd-$version"
etc="$FLR_ETC/poolmgrd"
db_dir=/var/lib/poolmgrd
restart=0
ensure_user poolmgrd "$db_dir"

{{- if and .PMCert .PMKey}}
# The Pool Manager daemon serves TLS from the same certificate and key
# every Host uses, written 0600 root:root because until now only
# flintlockd, running as root, needed to read them. poolmgrd runs as its
# own unprivileged system user, so grant that user's group read access
# rather than widen the file to everyone. The daemon also presents this
# certificate to flintlockd when the fleet uses mutual TLS.
if [ -e {{q .PMKey}} ] && [ "$(stat -c '%G:%a' {{q .PMKey}})" != "poolmgrd:640" ]; then
  chgrp poolmgrd {{q .PMKey}}
  chmod 0640 {{q .PMKey}}
  changed "poolmgrd read access to {{q .PMKey}}"
fi
{{- end}}

if [ ! -x "$bin" ]; then
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  asset="poolmgrd_${version#v}_linux_$FLR_ARCH.tar.gz"
  release="https://github.com/liquidmetal-dev/battery/releases/download/$version"
  download "$release/$asset" "$work/$asset"
  download "$release/checksums.txt" "$work/checksums.txt"
  (cd "$work" && grep " $asset\$" checksums.txt | sha256sum -c --quiet -) || die "checksum of $asset does not match"
  tar -xzf "$work/$asset" -C "$work" poolmgrd
  mkdir -p "$opt"
  install -m 0755 "$work/poolmgrd" "$bin"
  changed "poolmgrd $version"
  restart=1
fi

# The daemon's own API server and nothing else. A file an older Fleet
# Controller wrote still lists the Hosts; rewriting it here drops them,
# and the database keeps the Hosts battery took over from it.
new_config=$(mktemp)
printf '{\n  "api_server": {"addr": %s, "tls": %s}\n}\n' "$(json_str {{q .PMListen}})" \
{{- if and .PMCert .PMKey}}
  "{\"cert_file\": $(json_str {{q .PMCert}}), \"key_file\": $(json_str {{q .PMKey}})}" \
{{- else}}
  '{"insecure": true}' \
{{- end}}
  >"$new_config"
if write_file "$etc/config.json" 0600 poolmgrd:poolmgrd <"$new_config"; then
  restart=1
fi
rm -f "$new_config"

# The Lease state and the Hosts live in the SQLite database under $db_dir,
# which is never removed here: a restart for a new version keeps every
# Lease and every Host.
if write_file /etc/systemd/system/poolmgrd.service 0644 <<FLR_EOF
[Unit]
Description=battery Pool Manager daemon
Wants=network-online.target
After=network-online.target

[Service]
User=poolmgrd
Group=poolmgrd
ExecStart=$bin -config $etc/config.json -db $db_dir/poolmgr.db
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
FLR_EOF
then
  FLR_DAEMON_RELOAD=1
  restart=1
fi
ensure_service poolmgrd "$restart"
