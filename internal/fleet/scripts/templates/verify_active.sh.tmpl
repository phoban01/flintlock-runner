{{template "prelude" .}}

# FL-053: every service this Fleet Controller installed has to be active
# before the instance is reported as provisioned.
units=(containerd flintlockd flintlock-runner-network dnsmasq{{range .Services.Units}} {{.}}{{end}})
if [ -x /usr/local/bin/poolmgr-hostagent ]; then
  units+=(poolmgr-hostagent)
fi
failed=0
for u in "${units[@]}"; do
  if systemctl is-active --quiet "$u"; then
    printf '::active:: %s\n' "$u"
  else
    printf '::inactive:: %s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || true)"
    failed=1
  fi
done
[ "$failed" = 0 ] || die "some services are not active"
