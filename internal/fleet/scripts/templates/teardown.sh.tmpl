{{template "prelude" .}}

# Teardown stops and disables every service the Fleet Controller installed
# on the Host, the ones verify_active checks: the Host Services, flintlockd,
# containerd, the bridge's DHCP and DNS service and the guest bridge, and
# the Runner's service where `fleet up --install-runner` put it on a Host
# that is also the Control Node; fleet teardown stops it on the Control Node
# with the runner step. The thin pool and its device are removed only with
# the purge flag.
if [ -f /etc/nginx/conf.d/flintlock-runner.conf ]; then
  rm -f /etc/nginx/conf.d/flintlock-runner.conf
  changed "removed the nginx Host Service configuration"
fi
for u in flr flintlock-runner-buildkitd flintlock-runner-athens flintlock-runner-zot nginx flintlockd containerd dnsmasq flintlock-runner-network; do
  if systemctl cat "$u.service" >/dev/null 2>&1 &&
    { systemctl is-enabled --quiet "$u" || systemctl is-active --quiet "$u"; }; then
    systemctl disable --now --quiet "$u"
    changed "disabled $u"
  fi
done
{{- if eq (index .Options "purge") "true"}}
vg={{q .ThinPool}}
if vgs "$vg" >/dev/null 2>&1; then
  systemctl stop containerd || true
  pvs_of_vg=$(pvs --noheadings -o pv_name -S vg_name="$vg" | xargs)
  vgremove -f -y "$vg"
  for pv in $pvs_of_vg; do
    pvremove -y "$pv"
  done
  changed "purged thin pool $vg"
fi
{{- else}}
log "thin pool {{.ThinPool}} kept; pass the purge flag to remove it"
{{- end}}
