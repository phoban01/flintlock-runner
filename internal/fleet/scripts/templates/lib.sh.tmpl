{{- define "prelude" -}}
#!/usr/bin/env bash
# flintlock-runner fleet step "{{.Step}}". Generated by the Fleet Controller;
# do not edit on the Host. Every step is idempotent: running it again on a
# provisioned Host changes nothing and prints no ::changed:: line.
set -euo pipefail
umask 022
export DEBIAN_FRONTEND=noninteractive
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

FLR_STEP={{q .Step}}
FLR_ETC=/etc/flintlock-runner
FLR_STATE=/var/lib/flintlock-runner

log() { printf '%s: %s\n' "$FLR_STEP" "$*" >&2; }
die() {
  log "error: $*"
  exit 1
}
# changed reports a change on stdout; the Provisioner reads these lines to
# tell a no-op run from one that changed the Host (FL-030).
changed() { printf '::changed:: %s\n' "$*"; }

[ "$(id -u)" -eq 0 ] || die "must run as root"

# write_file PATH MODE [OWNER] writes its standard input to PATH when the
# content, mode or owner differ, and returns 0 only when it wrote.
write_file() {
  local path=$1 mode=$2 owner=${3:-root:root} tmp
  mkdir -p "$(dirname "$path")"
  tmp=$(mktemp "$path.flr.XXXXXX")
  cat >"$tmp"
  chmod "$mode" "$tmp"
  chown "$owner" "$tmp"
  if [ -f "$path" ] && cmp -s "$tmp" "$path" &&
    [ "$(stat -c '%a %U:%G' "$path")" = "${mode#0} $owner" ]; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$path"
  changed "$path"
  return 0
}

# ensure_packages installs the Debian packages that are missing.
ensure_packages() {
  local missing=() p
  for p in "$@"; do
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' || missing+=("$p")
  done
  [ "${#missing[@]}" -eq 0 ] && return 0
  apt-get update -qq
  apt-get install -y -qq --no-install-recommends "${missing[@]}"
  changed "packages ${missing[*]}"
}

# ensure_user creates a system user with no login shell.
ensure_user() {
  local user=$1 home=$2
  id -u "$user" >/dev/null 2>&1 && return 0
  useradd --system --home-dir "$home" --create-home --shell /usr/sbin/nologin "$user"
  changed "user $user"
}

# ensure_service enables and starts a unit, reloading systemd first when
# units changed and restarting the unit when its configuration changed.
ensure_service() {
  local unit=$1 restart=${2:-0}
  if [ "${FLR_DAEMON_RELOAD:-0}" = 1 ]; then
    systemctl daemon-reload
    FLR_DAEMON_RELOAD=0
  fi
  if ! systemctl is-enabled --quiet "$unit"; then
    systemctl enable --quiet "$unit"
    changed "enabled $unit"
  fi
  if ! systemctl is-active --quiet "$unit"; then
    systemctl start "$unit"
    changed "started $unit"
  elif [ "$restart" = 1 ]; then
    systemctl restart "$unit"
    changed "restarted $unit"
  fi
}

# download URL DEST fetches over https only, failing on any HTTP error.
download() {
  curl --proto '=https' --tlsv1.2 -fsSL --retry 3 -o "$2" "$1"
}

# Secrets arrive on standard input as "name base64(value)" lines (SE-015),
# or, where standard input is unavailable, from the Systems Manager
# parameter named for them, read on the Host. Neither path puts a secret on
# a command line or in a log.
declare -A FLR_SECRETS=()
read_secrets() {
  local name value
  [ -t 0 ] && return 0
  while read -r name value; do
    [ -n "$name" ] && FLR_SECRETS[$name]=$value
  done
  return 0
}
# secret NAME [PARAMETER] prints the value of a secret.
secret() {
  local name=$1 param=${2:-}
  if [ -n "${FLR_SECRETS[$name]:-}" ]; then
    printf '%s' "${FLR_SECRETS[$name]}" | base64 -d
    return 0
  fi
  if [ -n "$param" ]; then
    aws ssm get-parameter --with-decryption --name "$param" --query Parameter.Value --output text
    return 0
  fi
  die "secret $name was not supplied"
}
has_secret() {
  [ -n "${FLR_SECRETS[$1]:-}" ] || [ -n "${2:-}" ]
}

# json_str prints its argument as a JSON string.
json_str() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

# host_arch prints the Host's architecture in Go's naming.
host_arch() {
  case "$(uname -m)" in
  x86_64) echo amd64 ;;
  aarch64 | arm64) echo arm64 ;;
  *) die "unsupported machine $(uname -m)" ;;
  esac
}

# resolve_thin_pool_device DEV prints the block device the thin pool
# should use. AWS does not guarantee that NVMe device naming matches
# attachment order on Nitro instances: the same launch configuration can
# enumerate its data volume as nvme0n1 on one instance and nvme1n1 on
# another, so DEV - fixed in the configuration - can land on the root disk
# instead. Every step that touches the thin pool device (thin_pool,
# flintlock) calls this instead of trusting DEV directly, so they always
# agree on the same disk. Detect exactly that case - DEV is the one
# backing / - and substitute the other whole NVMe disk when there is
# exactly one unambiguous candidate; anything less clear-cut still dies
# rather than guessing which disk is safe to use.
resolve_thin_pool_device() {
  local dev=$1 root_src root_pk root_disk d candidates="" ncandidates=0 resolved
  root_src=$(findmnt -no SOURCE / 2>/dev/null || true)
  root_disk=""
  if [ -n "$root_src" ]; then
    root_pk=$(lsblk -no PKNAME "$root_src" 2>/dev/null || true)
    [ -n "$root_pk" ] && root_disk="/dev/$root_pk"
  fi
  if [ -z "$root_disk" ] || [ "$dev" != "$root_disk" ]; then
    printf '%s' "$dev"
    return 0
  fi
  for d in /dev/nvme*n1; do
    [ -b "$d" ] || continue
    [ "$d" = "$root_disk" ] && continue
    # -d/--nodeps: without it lsblk walks the dependency tree, so a disk
    # already carrying the thin pool's LVM structures prints one line per
    # holder ("disk", "lvm", "lvm", ...) instead of just "disk", and this
    # check would wrongly exclude it on every call after the first.
    [ "$(lsblk -dno TYPE "$d" 2>/dev/null)" = "disk" ] || continue
    candidates="$candidates $d"
    ncandidates=$((ncandidates + 1))
  done
  case "$ncandidates" in
  1)
    resolved=${candidates# }
    log "fleet.thin_pool_device $dev is this instance's root disk (AWS does not guarantee NVMe device naming matches attachment order); using $resolved instead"
    printf '%s' "$resolved"
    ;;
  *)
    die "fleet.thin_pool_device $dev is this instance's root disk and $ncandidates other whole NVMe disk(s) exist; refusing to guess which one is the data volume"
    ;;
  esac
}

# FLR_ARCH is the instance architecture the Fleet Controller discovered
# (FL-027); a Host whose kernel disagrees is refused rather than given
# binaries for the wrong architecture.
FLR_ARCH={{if .Arch}}{{q .Arch}}{{else}}"$(host_arch)"{{end}}
[ "$FLR_ARCH" = "$(host_arch)" ] || die "instance architecture $FLR_ARCH does not match the Host's $(host_arch)"

# FLR_ADDRESS is the Host's private address.
FLR_ADDRESS={{if .Address}}{{q .Address}}{{else}}"$(ip -o -4 route get 1.1.1.1 | sed -n 's/.* src \([0-9.]*\).*/\1/p')"{{end}}
export FLR_STEP FLR_ETC FLR_STATE FLR_ARCH FLR_ADDRESS
{{- end -}}
