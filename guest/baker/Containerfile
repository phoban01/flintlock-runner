# The Guest Image's baker image (docs/requirements/13-guest-image.md#guest-kind-bake):
# what a project's guest image build runs to bake its kind cluster spec.
# It holds flr-kind, which flr-bake runs as `flr-kind bake`,
# docker-store.sh, skopeo, curl, kustomize and helm. A project's
# Containerfile runs it in one stage and copies /out onto the kind image
# (docs/docker-and-kind.md).
#
# Build it with guest/build.sh, for linux/amd64 and linux/arm64. The build
# context is the repository root, for flr-kind's Go sources and for
# guest/rootfs-kind/docker-store.sh, which the kind image's build runs too.

# The versions, for the baker stage and for the published image's labels.
ARG HELM_VERSION=4.3.1
ARG KUSTOMIZE_VERSION=5.8.3

# ---------------------------------------------------------------------------
# flr-kind, cross-compiled on the build machine's own architecture.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26.5-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd AS flr-kind
ARG TARGETARCH
ENV GOTOOLCHAIN=auto CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/flr-kind/ cmd/flr-kind/
COPY internal/kindspec/ internal/kindspec/
COPY internal/kindbake/ internal/kindbake/
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    GOARCH="${TARGETARCH}" go build -trimpath -ldflags=-s -o /out/flr-kind ./cmd/flr-kind

# ---------------------------------------------------------------------------
# baker: Ubuntu with skopeo and curl from its archive, helm and kustomize
# from their releases, docker-store.sh, flr-kind and flr-bake.
#
#= docs/requirements/13-guest-image.md#guest-kind-bake
#/ The Guest Image SHALL include a baker image, for `linux/amd64`
#/ and `linux/arm64`, that contains `flr-kind`, `flr-bake`,
#/ `docker-store.sh`, skopeo and curl, and kustomize and helm at the
#/ versions pinned in its sources.
FROM docker.io/library/ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3 AS baker
ARG TARGETARCH
ARG HELM_VERSION
ARG KUSTOMIZE_VERSION
# From https://get.helm.sh/helm-v<version>-linux-<arch>.tar.gz.sha256sum.
ARG HELM_SHA256_AMD64=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
ARG HELM_SHA256_ARM64=8cf8f66ecbc252ac8f7f06cca68aba88508ddfde3a6a34feb1678ad1694b4f88
# From the kustomize release's checksums.txt.
ARG KUSTOMIZE_SHA256_AMD64=cb9e31198d3f63b44848bd0afc4c8efc56e6cfef9c93a4a39a211940e6decd61
ARG KUSTOMIZE_SHA256_ARM64=9867b76482cfc6d25b546abc1d2b5a32bd137505aba640649b4b378f64f6d68f
RUN --mount=type=bind,source=guest/baker/configure.sh,target=/tmp/configure.sh \
    bash /tmp/configure.sh
COPY guest/rootfs-kind/docker-store.sh /usr/local/libexec/flr/docker-store.sh
COPY guest/baker/flr-bake.sh /usr/local/bin/flr-bake
COPY --from=flr-kind /out/flr-kind /usr/local/bin/flr-kind
RUN chmod 0755 /usr/local/libexec/flr/docker-store.sh /usr/local/bin/flr-bake /usr/local/bin/flr-kind

# ---------------------------------------------------------------------------
# check: this image's checks, with an offline bake. On a platform other
# than the build machine's they run under emulation.
FROM baker AS check
#= docs/requirements/13-guest-image.md#guest-build
#/ The Guest Image build SHALL check the contents of each image it
#/ builds in a check stage that fails unless the image carries everything
#/ this document requires of it.
RUN --mount=type=bind,source=guest/baker/check.sh,target=/tmp/check.sh \
    bash /tmp/check.sh && mkdir -p /checked && \
    sha256sum /usr/share/flr-guest/versions.env >/checked/checked

# ---------------------------------------------------------------------------
# The published image. It takes a file from the check stage so that no
# builder can skip that stage as unused.
FROM baker
COPY --from=check /checked/checked /usr/share/flr-guest/checked
ARG HELM_VERSION
ARG KUSTOMIZE_VERSION
WORKDIR /src
LABEL org.opencontainers.image.title="flintlock-runner guest baker" \
      org.opencontainers.image.source="https://github.com/phoban01/flintlock-runner" \
      dev.flintlock.gitlab-runner.version.helm="${HELM_VERSION}" \
      dev.flintlock.gitlab-runner.version.kustomize="${KUSTOMIZE_VERSION}"
