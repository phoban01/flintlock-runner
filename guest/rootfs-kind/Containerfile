# The Guest Image's kind image (docs/requirements/13-guest-image.md#guest-kind):
# the Docker image of guest/rootfs-docker, plus kind and kubectl, the kind
# node image in Docker Engine's image store, flr-kind-cluster,
# /etc/default/kind-bootstrap for a Job to source, and the boot unit's hook
# that writes /etc/kind/kind-config.yaml with the Host's registry mirror.
#
# Build it with guest/build.sh. It builds guest/rootfs-docker first and
# passes that image to this build as the named build context
# guest-rootfs-docker. The build context is guest/, for the check.sh of
# the images below this one.

# The versions, for the kind stage and for the published image's labels.
# kind's release notes list the kindest/node images built for it; take the
# node image by its digest from there.
ARG KIND_VERSION=0.33.0
ARG KUBECTL_VERSION=1.37.1
ARG KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# ---------------------------------------------------------------------------
# node-image: the kind node image that KIND_NODE_IMAGE names, for the
# image's platform, written into Docker Engine's image store as
# /out/docker, which becomes the guest's /var/lib/docker. skopeo fetches it
# by the digest in KIND_NODE_IMAGE, checks the index against that digest
# and each blob against the digest that names it, and docker-store.sh
# checks each layer against the image configuration. It runs on the build
# machine; nothing here runs the image.
FROM --platform=$BUILDPLATFORM docker.io/library/ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3 AS node-image
ARG TARGETARCH
ARG KIND_NODE_IMAGE
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates skopeo && \
    rm -rf /var/lib/apt/lists/*
#= docs/requirements/13-guest-image.md#guest-kind-fast
#/ The Guest Image's kind image SHALL contain the node image that
#/ `KIND_NODE_IMAGE` names, for the image's architecture, in Docker
#/ Engine's image store under that reference, so that a kind cluster
#/ starts without a pull or a load of the node image.
RUN --mount=type=bind,source=rootfs-kind/docker-store.sh,target=/tmp/docker-store.sh \
    mkdir -p /out && \
    skopeo copy --override-os linux --override-arch "${TARGETARCH}" \
      "docker://docker.io/${KIND_NODE_IMAGE%%:*}@${KIND_NODE_IMAGE#*@}" "docker-archive:/tmp/node.tar:${KIND_NODE_IMAGE%@*}" && \
    bash /tmp/docker-store.sh /tmp/node.tar "${KIND_NODE_IMAGE}" /out/docker && \
    rm /tmp/node.tar

# ---------------------------------------------------------------------------
# kind: the Docker image with kind and kubectl.
#
#= docs/requirements/13-guest-image.md#guest-kind
#/ The Guest Image SHALL include a kind image, a root filesystem image
#/ built on its Docker image for `linux/amd64` and `linux/arm64`, which
#/ carries everything this document requires of the Docker image.
FROM guest-rootfs-docker AS kind
ARG TARGETARCH
ARG KIND_VERSION
ARG KUBECTL_VERSION
ARG KIND_NODE_IMAGE
# From the release's kind-linux-<arch>.sha256sum files.
ARG KIND_SHA256_AMD64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
ARG KIND_SHA256_ARM64=20022bee6cfcd5086cb7234d218e3454e6090022f2a8f55d1fa7fcf42c3867a2
# From https://dl.k8s.io/release/v<version>/bin/linux/<arch>/kubectl.sha256.
ARG KUBECTL_SHA256_AMD64=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
ARG KUBECTL_SHA256_ARM64=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7
COPY rootfs-kind/mirror-kind.sh /usr/libexec/flr-guest/registry-mirror.d/20-kind
COPY rootfs-kind/kind-cluster.sh /usr/local/bin/flr-kind-cluster
COPY rootfs-kind/var-lib-docker-volumes.mount /etc/systemd/system/var-lib-docker-volumes.mount
COPY --from=node-image /out/docker/ /var/lib/docker/
RUN --mount=type=bind,source=rootfs-kind/configure.sh,target=/tmp/configure.sh \
    bash /tmp/configure.sh

# ---------------------------------------------------------------------------
# check: the checks of the root filesystem image and of the Docker image,
# then this image's own. On a platform other than the build machine's they
# run under emulation.
FROM kind AS check
#= docs/requirements/13-guest-image.md#guest-build
#/ The Guest Image build SHALL check the contents of each image it
#/ builds in a check stage that fails unless the image carries everything
#/ this document requires of it.
RUN --mount=type=bind,source=rootfs/check.sh,target=/tmp/check-rootfs.sh \
    --mount=type=bind,source=rootfs-docker/check.sh,target=/tmp/check-docker.sh \
    --mount=type=bind,source=rootfs-kind/check.sh,target=/tmp/check.sh \
    bash /tmp/check-rootfs.sh && bash /tmp/check-docker.sh && bash /tmp/check.sh && \
    mkdir -p /checked && sha256sum /usr/share/flr-guest/versions.env >/checked/checked

# ---------------------------------------------------------------------------
# The published image. It takes a file from the check stage so that no
# builder can skip that stage as unused.
FROM kind
COPY --from=check /checked/checked /usr/share/flr-guest/checked
ARG KIND_VERSION
ARG KUBECTL_VERSION
LABEL org.opencontainers.image.title="flintlock-runner guest root filesystem with Docker and kind" \
      dev.flintlock.gitlab-runner.version.kind="${KIND_VERSION}" \
      dev.flintlock.gitlab-runner.version.kubectl="${KUBECTL_VERSION}"
