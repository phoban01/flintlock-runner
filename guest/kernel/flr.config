# The options guest/kernel builds into the Guest Image's kernel on top of
# Firecracker's CI configuration, for both architectures. Each line is one
# option, =y or "is not set"; kernel/check.sh checks that the built .config
# has every one.
#
# kube-proxy and kindnet in a kind cluster: the iptables raw table, and
# the comment, mark, statistic and multiport matches and the MARK target.
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
# Cloud Hypervisor: its disk, network and vsock devices are virtio-pci.
# Firecracker's devices are virtio-mmio, which stays.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_VSOCKETS=y
# Pressure stall information, so a Job can read /proc/pressure. Firecracker's
# configuration builds PSI in but turns it off unless the kernel boots with
# psi=1; this turns it on by default.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
