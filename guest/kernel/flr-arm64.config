# The options guest/kernel adds for arm64 only, after flr.config. Cloud
# Hypervisor's arm64 guests find PCI through a generic ECAM host bridge,
# take MSIs through the GICv3 ITS, and have a PL011 serial console.
CONFIG_PCI_HOST_GENERIC=y
CONFIG_ARM_GIC_V3_ITS=y
CONFIG_ARM_GIC_V3_ITS_PCI=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
