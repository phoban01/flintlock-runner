# The Go module proxy's settings, the host_services.go_proxy section of push
# provisioning. render.sh reads KEY=value lines; nothing here is secret.

# FL-105: where public modules come from.
UPSTREAM=https://proxy.golang.org

# FL-105, FL-114: GOPRIVATE-style patterns fetched from PRIVATE_VCS_HOST with
# the credential of the Secret flintlock-go-proxy-credential, and not checked
# against the public checksum database. Comma-separated; empty for none.
PRIVATE_PATTERNS=
PRIVATE_VCS_HOST=

# FL-115: how long private module listings are served from cache before the
# version control host is asked again, in seconds.
PRIVATE_REVALIDATE_SECONDS=86400
