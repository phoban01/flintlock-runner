# The flintlock-runner Host Image (docs/requirements/11-host-image.md).
#
# Build it with `make image` from the repository root, which passes the
# versions of image/versions.env as build arguments so that they can become
# OCI labels; the build fails when an argument disagrees with the file. The
# build context is the image/ directory. The steps live in build/*.sh rather
# than in heredocs so that every builder runs them and shellcheck reads them.

#= docs/requirements/11-host-image.md#image-build
#/ The Host Image SHALL be defined by one Containerfile whose base
#/ is a bootc base image pinned by digest.
# quay.io/fedora/fedora-bootc:44 as of 2026-09-21. The digest is that of the
# multi-architecture index; --platform selects x86_64 from it.
#
#= docs/requirements/11-host-image.md#image-build
#/ The Host Image SHALL be built for the `x86_64` architecture.
FROM --platform=linux/amd64 quay.io/fedora/fedora-bootc@sha256:adc14024700a3bccb9e4321514ff8ab8b7dec1b2485c070b5d7ce27f282a93a5 AS base

# ---------------------------------------------------------------------------
# fetch: download and verify every binary that does not come from a signed
# package repository (HI-004). It reads the versions file and nothing else,
# and runs nothing it downloads, so it runs on the build machine's own
# architecture: the same pinned index, without emulation.
FROM --platform=$BUILDPLATFORM quay.io/fedora/fedora-bootc@sha256:adc14024700a3bccb9e4321514ff8ab8b7dec1b2485c070b5d7ce27f282a93a5 AS fetch
COPY versions.env build/fetch.sh /build/
RUN bash /build/fetch.sh /build/versions.env

# ---------------------------------------------------------------------------
# selinux: compile the policy module against the base image's own policy.
FROM base AS selinux
COPY selinux/ /src/
RUN dnf -y install selinux-policy-devel make && \
    make -C /src -f /usr/share/selinux/devel/Makefile flr.pp

# ---------------------------------------------------------------------------
# image: the Host Image itself.
FROM base AS image
ARG CONTAINERD_VERSION
ARG RUNC_VERSION
ARG FIRECRACKER_VERSION
ARG CLOUD_HYPERVISOR_VERSION
ARG FLINTLOCK_VERSION
ARG KUBERNETES_VERSION
ARG CLOUD_INIT_VERSION

#= docs/requirements/11-host-image.md#image-build
#/ The Host Image SHALL contain containerd, Firecracker with its
#/ jailer, Cloud Hypervisor, `flintlockd`, the kubelet, `kubeadm` and
#/ cloud-init at the versions pinned in one versions file that the
#/ Containerfile reads.
COPY versions.env /usr/share/flr/versions.env
# The repository key goes in before the packages it verifies; the binaries
# go in after them, so that a package which one day ships a binary of the
# same name cannot stand in for a pinned one. None does today.
COPY --from=fetch /out/etc/ /etc/
COPY build/packages.sh /tmp/flr-build/packages.sh
RUN bash /tmp/flr-build/packages.sh
COPY --from=fetch /out/usr/ /usr/

COPY rootfs/ /
COPY check.sh /usr/libexec/flr/check
COPY check-thin-pool.sh /usr/libexec/flr/check-thin-pool-cases
COPY --from=selinux /src/flr.pp /usr/share/selinux/packages/flr.pp
COPY build/configure.sh /tmp/flr-build/configure.sh
RUN bash /tmp/flr-build/configure.sh && rm -rf /tmp/flr-build

COPY build/bootc-lint.sh /tmp/flr-build/bootc-lint.sh
RUN bash /tmp/flr-build/bootc-lint.sh && rm -rf /tmp/flr-build

# ---------------------------------------------------------------------------
# check: run the checks inside the built image.
FROM image AS check
#= docs/requirements/11-host-image.md#image-build
#/ The Host Image build SHALL run a check stage inside the built
#/ container image that fails unless every component of HI-003 reports its
#/ pinned version and every unit this document requires is enabled.
RUN /usr/libexec/flr/check && mkdir -p /checked && \
    sha256sum /usr/share/flr/versions.env >/checked/checked

# ---------------------------------------------------------------------------
# The published image. It takes a file from the check stage so that no
# builder can skip that stage as unused: an image that fails its checks is
# never produced.
FROM image
COPY --from=check /checked/checked /usr/share/flr/checked

ARG CONTAINERD_VERSION
ARG RUNC_VERSION
ARG FIRECRACKER_VERSION
ARG CLOUD_HYPERVISOR_VERSION
ARG FLINTLOCK_VERSION
ARG KUBERNETES_VERSION
ARG CLOUD_INIT_VERSION
#= docs/requirements/11-host-image.md#image-build
#/ The Host Image SHALL record the pinned version of each component
#/ of HI-003 as an OCI image label and in a versions file on the image's
#/ `/usr` tree.
LABEL org.opencontainers.image.title="flintlock-runner Host Image" \
      org.opencontainers.image.source="https://github.com/phoban01/flintlock-runner" \
      containers.bootc="1" \
      dev.flintlock.gitlab-runner.version.containerd="${CONTAINERD_VERSION}" \
      dev.flintlock.gitlab-runner.version.runc="${RUNC_VERSION}" \
      dev.flintlock.gitlab-runner.version.firecracker="${FIRECRACKER_VERSION}" \
      dev.flintlock.gitlab-runner.version.cloud-hypervisor="${CLOUD_HYPERVISOR_VERSION}" \
      dev.flintlock.gitlab-runner.version.flintlock="${FLINTLOCK_VERSION}" \
      dev.flintlock.gitlab-runner.version.kubernetes="${KUBERNETES_VERSION}" \
      dev.flintlock.gitlab-runner.version.cloud-init="${CLOUD_INIT_VERSION}"
