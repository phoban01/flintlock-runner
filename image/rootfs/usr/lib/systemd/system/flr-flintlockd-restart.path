#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL start `flintlockd` only once the serving
#/ certificate, its key and the client CA bundle exist in
#/ `/etc/battery/flintlockd`, and SHALL restart `flintlockd` when the serving
#/ certificate or the client CA bundle changes.
# The Exec Agent renews by writing tls.key and then tls.crt, each through a
# rename, and replaces client-ca.crt the same way when the Operator's
# client CA bundle changes. tls.key is not watched: it never changes
# without tls.crt changing after it. flintlockd reads all three only when
# it starts, until flintlock#1235.
[Unit]
Description=Restart flintlockd when its certificates change
Documentation=https://github.com/phoban01/flintlock-runner/blob/main/image/README.md
# Ordered after services, so without the default dependencies: those put a
# path unit before paths.target, which every service is ordered after.
DefaultDependencies=no
Conflicts=shutdown.target
Requires=flr-flintlockd-certs.service
After=flr-flintlockd-certs.service
Before=shutdown.target

[Path]
PathChanged=/etc/battery/flintlockd/tls.crt
PathChanged=/etc/battery/flintlockd/client-ca.crt
Unit=flr-flintlockd-restart.service

[Install]
WantedBy=multi-user.target
