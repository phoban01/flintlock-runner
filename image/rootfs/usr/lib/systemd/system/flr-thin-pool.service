#= docs/requirements/11-host-image.md#image-storage
#/ The Host Image SHALL create the containerd devicemapper thin
#/ pool at boot on the block device named in the Host configuration file, or,
#/ when none is named, on the unused instance-store device it detects.
# Before=containerd.service so that containerd finds its pool when it loads
# the devmapper snapshotter. flintlockd.service Requires= this unit; the
# reason for a failure is in /run/flr/not-ready.d/flr-thin-pool.
[Unit]
Description=flintlock-runner containerd thin pool
Documentation=https://github.com/phoban01/flintlock-runner/blob/main/image/README.md
Requires=flr-host-config.service
After=flr-host-config.service systemd-modules-load.service lvm2-monitor.service
Before=containerd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/flr/thin-pool
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
