#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL run `flintlockd`, its containerd and every
#/ hypervisor process they start as systemd services outside the cgroup of
#/ any Kubernetes pod.
# Firecracker and Cloud Hypervisor processes are started detached by
# flintlockd and stay in this unit's cgroup under system.slice.
# KillMode=process keeps a restart of flintlockd, which a certificate
# renewal causes, from killing the MicroVMs it started; see "flintlockd" in
# docs/requirements/11-host-image.md for why they survive it.
#
# No [Install] section: flintlockd.path starts this unit once the Exec
# Agent has written its certificates (HI-071).
[Unit]
Description=flintlock microvm service
Documentation=https://www.liquidmetal.dev
#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL start `flintlockd` only after the thin
#/ pool and the bridge are present.
# Requires= as well as After=: when the KVM gate or the thin pool unit
# fails, flintlockd is not started at all (HI-011, HI-022).
Requires=flr-kvm.service flr-thin-pool.service flr-network.service flr-flintlockd-certs.service containerd.service
After=flr-kvm.service flr-thin-pool.service flr-network.service flr-flintlockd-certs.service containerd.service
#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL start `flintlockd` only once the serving
#/ certificate, its key and the client CA bundle exist in
#/ `/etc/battery/flintlockd`
# flintlockd.path waits for tls.crt, which the Exec Agent writes last; these
# keep any other start, a restart among them, from looping on a missing file.
ConditionPathExists=/etc/battery/flintlockd/tls.crt
ConditionPathExists=/etc/battery/flintlockd/tls.key
ConditionPathExists=/etc/battery/flintlockd/client-ca.crt

[Service]
#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL configure `flintlockd` to serve its gRPC
#/ API only with TLS, on port 9090 of the Host's internal address, with the
#/ serving certificate and key that the Exec Agent writes to
#/ `/etc/battery/flintlockd`.
# flr-network writes FLR_FLINTLOCKD_ENDPOINT, the Host's internal address
# and port 9090, which battery-operator's Exec Agent reaches as
# $(HOST_IP):9090 and battery as the Node report's flintlockd address. There
# is no --insecure, so flintlockd refuses to start without the certificate
# and key, and it listens nowhere else: not on loopback, and not on the
# bridge gateway guests see. The HTTP gateway (--enable-http) and the debug
# endpoint stay off.
#
#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL configure `flintlockd` to require a client
#/ certificate on every connection and to verify it against the `flintlockd`
#/ client CA bundle that the Exec Agent writes to `/etc/battery/flintlockd`.
# --tls-client-validate makes flintlockd's TLS configuration
# RequireAndVerifyClientCert, against the pool --tls-client-ca names
# (pkg/auth/tls.go of flintlock v0.15.2). No token: the certificate is the
# credential, and the Host firewall decides who may try (HI-069, HI-070).
#
#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL enable the `flintlockd` exec API.
EnvironmentFile=/run/flr/flintlockd.env
ExecStartPre=/usr/libexec/flr/flintlockd-certs started
ExecStart=/usr/bin/flintlockd run \
    --grpc-endpoint ${FLR_FLINTLOCKD_ENDPOINT} \
    --tls-cert /etc/battery/flintlockd/tls.crt \
    --tls-key /etc/battery/flintlockd/tls.key \
    --tls-client-validate \
    --tls-client-ca /etc/battery/flintlockd/client-ca.crt \
    --enable-exec-api \
    --bridge-name flbr0 \
    --containerd-socket /run/containerd/containerd.sock \
    --state-dir /var/lib/flintlock \
    --firecracker-bin /usr/bin/firecracker \
    --cloudhypervisor-bin /usr/bin/cloud-hypervisor-static
Restart=always
RestartSec=5
User=root
#= docs/requirements/11-host-image.md#image-flintlockd
#/ When the Host Image stops or restarts `flintlockd`, it SHALL
#/ stop the `flintlockd` process alone and SHALL leave every hypervisor
#/ process that `flintlockd` started running.
# systemd signals the main process alone. There is no ExecStop, so
# nothing else stops the hypervisors either.
KillMode=process
LimitNOFILE=1048576
