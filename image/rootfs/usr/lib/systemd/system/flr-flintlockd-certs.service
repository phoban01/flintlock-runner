#= docs/requirements/11-host-image.md#kernel-and-kvm
#/ The Host Image SHALL create `/etc/battery/flintlockd` owned by
#/ the Exec Agent's user id, and SHALL label that directory and every file in
#/ it so that the Exec Agent's containers can write them and `flintlockd` can
#/ read them, under the base image's SELinux policy and without changing the
#/ domain of any container.
# The Exec Agent's DaemonSet mounts the directory as a hostPath of type
# Directory, so it is made before the kubelet starts; the owner is
# EXEC_AGENT_UID of the Host configuration file, which is why this is not a
# tmpfiles.d line.
[Unit]
Description=flintlock-runner directory for flintlockd's certificates
Documentation=https://github.com/phoban01/flintlock-runner/blob/main/image/README.md
Requires=flr-host-config.service
After=flr-host-config.service
Before=kubelet.service flintlockd.path

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/flr/flintlockd-certs prepare

[Install]
WantedBy=multi-user.target
