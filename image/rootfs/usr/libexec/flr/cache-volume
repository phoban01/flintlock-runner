#!/usr/bin/bash
# flr-cache.service: the Host Service cache directory, on a plain logical
# volume of the thin pool's volume group, which is to say on the same
# instance-store device. It survives a reboot and an in-place upgrade with
# the pool, and dies with the instance like the pool does.
FLR_UNIT=flr-cache
# shellcheck source=image/rootfs/usr/libexec/flr/lib.sh
. "${FLR_LIB:-/usr/libexec/flr/lib.sh}"
load_host_env

vg=$FLR_VG
lv=cache
dir=$FLR_CACHE_DIR

#= docs/requirements/11-host-image.md#image-storage
#/ The Host Image SHALL create the Host Service cache directory on
#/ instance-store storage and SHALL keep all `flintlockd` and containerd
#/ state under `/var`.
# The state half is configuration rather than code: flintlockd.service
# passes --state-dir /var/lib/flintlock and /etc/containerd/config.toml sets
# root = /var/lib/containerd.
#= docs/requirements/11-host-image.md#kernel-and-kvm
#/ The Host Image SHALL label the Host environment file and the
#/ not ready reason directory it writes under `/run/flr` so that the Host
#/ Agent's containers can read them, and the Host Service cache directory so
#/ that they can write it
# What the Host Agent mounts is the root of the cache volume's filesystem,
# whose label is on the volume, not the mount point's. A new filesystem's
# root has none the Host Agent may use, so it is given the cache
# directory's label (selinux/flr.fc) after every mount; what the Host
# Services create inside it inherits the type. The root alone is relabelled:
# a recursive restorecon of a full cache would take minutes.
label_cache() { relabel "$dir" || die "cannot label $dir for the Host Agent"; }

mkdir -p "$dir"
if mountpoint -q "$dir"; then
  log "$dir is mounted"
  label_cache
  exit 0
fi
if ! lvs "$vg/$lv" >/dev/null 2>&1; then
  [ "$FLR_CACHE_VOLUME_PERCENT" -gt 0 ] || die "CACHE_VOLUME_PERCENT is 0 and no $vg/$lv volume exists"
  # A group made by an older layout may have no room left; take what is
  # free rather than fail, and fail only when nothing is.
  lvcreate -q -y -n "$lv" "$vg" -l "${FLR_CACHE_VOLUME_PERCENT}%VG" 2>/dev/null ||
    lvcreate -q -y -n "$lv" "$vg" -l 100%FREE ||
    die "no free space in volume group $vg for the cache volume"
fi
lvchange -ay "$vg/$lv" >/dev/null 2>&1 || true
# An existing filesystem is kept as it is; only a blank volume is formatted.
if [ -z "$(blkid -p -o value -s TYPE "/dev/$vg/$lv" 2>/dev/null || true)" ]; then
  mkfs.ext4 -q -L flr-cache "/dev/$vg/$lv"
fi
mount -o defaults "/dev/$vg/$lv" "$dir"
label_cache
log "mounted /dev/$vg/$lv at $dir"
