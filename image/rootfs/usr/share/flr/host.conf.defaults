# The Host Image's defaults for the Host configuration file,
# /etc/flintlock-runner/host.conf, in the same format. cloud-init writes that
# file at first boot (KF-003); a key it leaves out, or the whole file when it
# is absent, takes the value below. See image/README.md.
#
# This file holds settings, never secrets: nothing on a Host reads a
# credential from it.

#= docs/requirements/11-host-image.md#host-configuration
#/ If the Host configuration file is absent, then the Host Image
#/ SHALL boot with its defaults for every setting.

# The guest bridge subnet, an IPv4 CIDR of /29 or larger. Keep it clear of
# the cluster's node, pod and service ranges. The default is
# config.DefaultGuestSubnet of this repository.
GUEST_SUBNET=172.31.0.0/16

# The block device for the containerd thin pool. Empty means detect the
# unused instance-store device.
THIN_POOL_DEVICE=

# Comma-separated IPv4 CIDRs no guest may reach: the cluster's node and pod
# ranges and anything else a job has no business with.
PROTECTED_CIDRS=

# The Host reserve: what the Host's own Node offers to pods. Everything
# beyond it belongs to MicroVMs on the Virtual Node.
HOST_RESERVE_VCPU=2
HOST_RESERVE_MEMORY_MB=4096

# The Host Service ports guests may reach on the bridge gateway: buildkitd,
# the Go module proxy, the registry mirror and the HTTP cache.
HOST_SERVICE_PORTS=1234,3000,5000,3128

# The Host's own ports guests may never reach: flintlockd's gRPC and HTTP
# endpoints, the kubelet (10250 and its health, read-only and proxy ports),
# the Pod Provider's kubelet endpoint (10260), the Exec Agent's exec API
# (10270) and the metrics listeners.
HOST_CONTROL_PORTS=9090,8090,10248,10250,10255,10256,10260,10270,9252,1338

# The share of the thin pool volume group given to the Host Service cache
# volume when the group is first created, 0 to 50.
CACHE_VOLUME_PERCENT=15

#= docs/requirements/11-host-image.md#image-flintlockd
#/ The Host Image SHALL admit connections to the local
#/ `flintlockd` endpoint only from the Pod Provider's user id, which it reads
#/ from the Host configuration file with a default when none is set
# The user id the Pod Provider's container runs as, the only one that may
# connect to flintlockd's local endpoint. Never 0. The Fleet Manifests run
# the Pod Provider as this id and nothing else of the Host Agent as it
# (KF-135); change both together.
POD_PROVIDER_UID=10250

#= docs/requirements/11-host-image.md#image-networking
#/ The Host Image SHALL drop traffic from the user ids that run the
#/ Host Services, which it reads from the Host configuration file with
#/ defaults when none are set
# The user ids the Host Services run as, which may reach neither the
# instance metadata service nor the Host's control ports and flintlockd.
# Comma-separated ids and ranges LOW-HIGH, never 0 and never the Pod
# Provider's. The Fleet Manifests run nginx as 101, buildkitd as 1000,
# Athens as 10001 and zot as 10002 (`make manifests-check` compares them
# with this line); 100000-165535 are the subordinate ids of the buildkit
# image's user, which a build step run as any user but root has. Change
# both together.
HOST_SERVICE_UIDS=101,1000,10001,10002,100000-165535
