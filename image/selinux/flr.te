policy_module(flr, 1.1.0)

# The Host Image's SELinux policy module. See "SELinux" in image/README.md.
#
#= docs/requirements/11-host-image.md#kernel-and-kvm
#/ Where a component cannot run under the base image's SELinux
#/ policy, the Host Image SHALL ship a policy module that relaxes confinement
#/ for that component's domain only.
#
# The one component the base policy stops is dnsmasq. It runs confined as
# dnsmasq_t, and the base policy lets that domain read its configuration
# from /etc/dnsmasq.conf and /etc/dnsmasq.d only. The Host Image generates
# the configuration at every boot from the Host configuration file and keeps
# it in /run/flr with the rest of its runtime state, which dnsmasq_t may not
# read. This module gives /run/flr a type of its own and lets dnsmasq_t read
# it, and changes nothing for any other domain.

gen_require(`
	type dnsmasq_t;
')

type flr_run_t;
files_pid_file(flr_run_t)

allow dnsmasq_t flr_run_t:dir { getattr search open read };
allow dnsmasq_t flr_run_t:file { getattr open read ioctl lock };

#= docs/requirements/11-host-image.md#kernel-and-kvm
#/ The Host Image SHALL label the Host environment file and the
#/ not ready reason directory it writes under `/run/flr` so that the Host
#/ Agent's containers can read them, and the Host Service cache directory so
#/ that they can write it, under the base image's SELinux policy and without
#/ changing the domain of any container or the label of any other path.
#
# The Host Agent's containers run as container_t. That is not changed here:
# this module has no rule for container_t or any other container domain.
# The three paths the Host Agent mounts are instead labelled, in flr.fc, with
# the types the base image's container-selinux policy already gives
# container_t, at level s0, which has no categories and is therefore
# dominated by every container's level:
#
#   /run/flr/host.env, /run/flr/not-ready.d   container_ro_file_t:s0, which
#       container_t may read and not write
#   /var/lib/flintlock-runner/cache           container_file_t:s0, which
#       container_t may read and write
#
# Both types are declared by container-selinux; requiring them makes the
# module refuse to install without it rather than install a file context
# that names nothing.
gen_require(`
	type container_file_t;
	type container_ro_file_t;
')
